  <application android:name=".FinoraApplication" android:icon="@drawable/finora_mark" android:label="FINORA" android:allowBackup="false" android:usesCleartextTraffic="false" android:theme="@style/FinoraWindow">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".BankListener" android:exported="false" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
    </service>
  </application>
</manifest>
