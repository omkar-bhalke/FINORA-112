rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/avatar.jpg {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.size < 700000 && request.resource.contentType == 'image/jpeg';
    }
  }
}
